<header class="topbar">
<button class="burger" id="burger" aria-label="Menu">
<i data-lucide="menu" style="width:32px;height:32px"></i>
</button>
<div class="right">
<span class="bell"><i data-lucide="bell"></i></span>
<a class="avatar" href="profil_ustadz.html"><span>U</span></a>
</div>
</header>

<main class="main">

<h1>Manajemen Jadwal</h1>
<p class="lead">Atur jadwal mengaji tiap kelas.</p>

<div class="card">
<h2>Tambah Jadwal</h2>

<form action="jadwal.html">
<div class="form-row">

<div class="field">
<label>Kelas</label>
<select>
<option>Iqra 1-2</option>
<option>Iqra 3-4</option>
<option>Iqra 5-6</option>
<option>Al-Quran</option>
</select>
</div>

<div class="field">
<label>Hari</label>
<select>
<option>Senin</option>
<option>Selasa</option>
<option>Rabu</option>
<option>Kamis</option>
<option>Jumat</option>
<option>Sabtu</option>
<option>Minggu</option>
</select>
</div>

<div class="field">
<label>Mulai</label>
<input type="time" value="15:30" required>
</div>

<div class="field">
<label>Selesai</label>
<input type="time" value="17:00" required>
</div>

<div class="field">
<label>Ruang</label>
<input value="Ruang A">
</div>

</div>

<button class="btn btn-primary">Tambah Jadwal</button>
</form>
</div>

<div class="item">
<div class="ch">
<div class="sch">
<div class="day">Sen</div>
<div>
<b>Iqra 1-2 — Senin</b>
<small>15:30 - 17:00 • Ruang A</small>
</div>
</div>

<form action="jadwal.html" onsubmit="return confirm('Hapus jadwal?')">
<button class="btn btn-danger btn-sm">Hapus</button>
</form>
</div>
</div>

<div class="item">
<div class="ch">
<div class="sch">
<div class="day">Rab</div>
<div>
<b>Iqra 1-2 — Rabu</b>
<small>15:30 - 17:00 • Ruang A</small>
</div>
</div>

<form action="jadwal.html" onsubmit="return confirm('Hapus jadwal?')">
<button class="btn btn-danger btn-sm">Hapus</button>
</form>
</div>
</div>

</main>

<div class="foot">NgajiKu — Pendaftaran &amp; Monitoring Kehadiran Ngaji</div>
</div>

